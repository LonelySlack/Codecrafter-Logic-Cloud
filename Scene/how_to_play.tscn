[node name="RichTextLabel" type="RichTextLabel" parent="ScrollContainer/PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(800, 0)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[center]
[b][font_size=24]HOW TO PLAY - DATA TYPE LEVEL[/font_size][/b]

[b]Your Goal[/b]
This level focuses on identifying the correct data type.
To move forward, place each value into the correct [color=#ffeb3b]bucket[/color].

[b][font_size=20]How to Play[/font_size][/b]
1. A value will appear on the screen
2. Click and drag the value with your mouse
3. Drop it into one of the buckets
4. If it's correct, the path unlocks

[color=#6a9955]Tip: Look closely at how the value is written.[/color]

[b][font_size=20]About This Level[/font_size][/b]
- Only data types are tested in this level
- No functions or expressions are used here
- Focus on observation and matching

Good luck - and have fun learning!
[/center]
"
scroll_active = false


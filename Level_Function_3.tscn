text = "[center][b][font_size=24]Level: [color=#ffa500]Function Chaining[/color][/font_size][/b][/center]

[b]Objective:[/b]
System requires synthetic element: [color=#ffa500]ORANGE[/color].
[i]Available Resources:[/i] [color=#d500f9]PURPLE[/color] and [color=#ffff00]YELLOW[/color].

[b]Code Protocol:[/b]
[code]
[color=#4ec9b0]String[/color] [color=#dcdcaa]createOrange[/color]() {

    [color=#4ec9b0]String[/color][] parts = [color=#dcdcaa]split[/color]([color=#d500f9]\"purple\"[/color]);
    [color=#4ec9b0]String[/color] [color=#ff4444]extractedRed[/color] = parts[[color=#b5cea8]0[/color]];

    [color=#c586c0]return[/color] [color=#dcdcaa]combine[/color]([color=#ff4444]extractedRed[/color], [color=#ffff00]\"yellow\"[/color]);
}
[/code]

[color=gray][i]Stuck? Check the [b]Main Menu[/b] for the Tutorial.[/i][/color]"
fit_content = true
scroll_active = false


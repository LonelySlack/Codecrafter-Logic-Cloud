[node name="RichTextLabel" type="RichTextLabel" parent="MarginContainer/VBoxContainer/HBoxContainer/Objective Panel/ScrollContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
bbcode_enabled = true
text = "[center][b][font_size=24]Level: [color=#ffd700]Logic Gates (AND)[/color][/font_size][/b][/center]

[b]Objective:[/b]
The system output must be [color=#ffffff]1 (White/True)[/color].
[i]Problem:[/i] The AND gate is strict. It defaults to [color=#888888]0 (Black)[/color].
[b]Solution:[/b] Connect [b]BOTH[/b] inputs to [color=#ffffff]1 (White)[/color]. If even one is Black, it fails.

[b]Truth Table (AND Gate):[/b]
[table=3]
[cell border=#444444 bg=#222222][color=#4bb8f0] [b]IN A[/b] [/color][/cell] [cell border=#444444 bg=#222222][color=#4bb8f0] [b]IN B[/b] [/color][/cell] [cell border=#444444 bg=#222222][color=#ff5555] [b]OUT[/b] [/color][/cell]
[cell border=#444444 bg=#111111] 0 [/cell] [cell border=#444444 bg=#111111] 0 [/cell] [cell border=#444444 bg=#111111] [color=#888888]0[/color] [/cell]
[cell border=#444444 bg=#111111] 0 [/cell] [cell border=#444444 bg=#111111] 1 [/cell] [cell border=#444444 bg=#111111] [color=#888888]0[/color] [/cell]
[cell border=#444444 bg=#111111] 1 [/cell] [cell border=#444444 bg=#111111] 0 [/cell] [cell border=#444444 bg=#111111] [color=#888888]0[/color] [/cell]
[cell border=#444444 bg=#111111] 1 [/cell] [cell border=#444444 bg=#111111] 1 [/cell] [cell border=#444444 bg=#111111] [color=#ffffff]1[/color] [/cell]
[/table]

[b]The Logic:[/b]
The AND gate requires consensus. It returns [color=#ffffff]1 (True)[/color] ONLY if input A is True [b]AND[/b] input B is True.

[color=#888888]// Java Equivalent:[/color]
[code]boolean y = (a && b);[/code]"
fit_content = true
scroll_active = false


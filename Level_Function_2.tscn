text = "[b]Objective:[/b] Execute [code]split()[/code] on [code][color=purple]\"purple\"[/color][/code] to retrieve [code][color=red]\"red\"[/color][/code] and [code][color=cornflowerblue]\"blue\"[/color][/code].

[b]Code Protocol:[/b]
[code]
[color=#4ec9b0]String[/color][] [color=#dcdcaa]breakDownPurple[/color]() {

    [color=#6a9955]// 1. The Process (Splitting)[/color]
    [color=#6a9955]// Break purple back into components[/color]
    [color=#c586c0]return[/color] [color=#dcdcaa]split[/color]([color=#d500f9]\"purple\"[/color]);
}
[/code]

"
fit_content = true
